XP_WIKI_ENV_FILE=

# Server URL used to derive default OAuth callback URLs.
XP_WIKI_BASE_URL=http://127.0.0.1:8080

# UI URL to open after OAuth succeeds. Leave blank to use / on the same server.
XP_WIKI_UI_URL=
XP_WIKI_DATA_DIR=wiki-data
XP_WIKI_SESSION_FILE=wiki-data/sessions.json
XP_WIKI_ROLE_FILE=wiki-data/roles.json
XP_WIKI_USER_FILE=wiki-data/users.json
XP_WIKI_DEFAULT_ROLE=editor
XP_WIKI_ADMIN_USERS=
XP_WIKI_EDITOR_USERS=
XP_WIKI_VIEWER_USERS=

# Used by the desktop client to call the Dioxus fullstack server.
XP_WIKI_SERVER_URL=http://127.0.0.1:8080

# GitHub OAuth app
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URL=http://127.0.0.1:8080/auth/callback/github
OAUTH_GITHUB_SCOPES=read:user,user:email

# Google OAuth client
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=http://127.0.0.1:8080/auth/callback/google
OAUTH_GOOGLE_SCOPES=openid profile email

# Discord OAuth2 application
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_DISCORD_REDIRECT_URL=http://127.0.0.1:8080/auth/callback/discord
OAUTH_DISCORD_SCOPES=identify email
